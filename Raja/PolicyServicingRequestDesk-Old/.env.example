# Policy Servicing Request Desk - Environment Configuration
# Copy this file to .env.local and fill in your values

# Dataverse Environment URL (required)
VITE_DATAVERSE_URL=https://orgXXXXXXXX.crm.dynamics.com

# Enable mock data in development (set to 'true' to use mock data without Dataverse)
VITE_USE_MOCK=true

# Application Insights Connection String (optional - for telemetry)
VITE_APP_INSIGHTS_CONNECTION_STRING=InstrumentationKey=XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Azure OpenAI Configuration (optional)
VITE_AZURE_OPENAI_ENDPOINT=https://YOURINSTANCE.openai.azure.com/
VITE_AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Copilot Studio Direct Line Secret (for embedded agent)
VITE_COPILOT_DIRECTLINE_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Feature Flags
VITE_ENABLE_AI_AGENT=true
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_BULK_OPERATIONS=true
