{
  "requestTypes": [
    {
      "id": "address-change",
      "name": "Address Change",
      "displayName": "Change Address",
      "icon": "📍",
      "description": "Update the registered address on the policy",
      "category": "Administrative",
      "priority": "Medium",
      "requiredFields": [
        "newAddress",
        "verificationId"
      ],
      "optionalFields": [
        "addressType",
        "effectiveDate",
        "notes"
      ],
      "eligibilityRules": [
        {
          "field": "policyStatus",
          "condition": "notIn",
          "values": ["Suspended", "Lapsed"],
          "message": "Policy must be Active or Inactive (not Suspended or Lapsed)"
        }
      ],
      "requiredApproval": false,
      "sla": {
        "days": 2,
        "businessHoursOnly": true
      },
      "automationRules": [
        {
          "action": "updateField",
          "field": "billingAddress",
          "source": "newAddress"
        }
      ],
      "notification": {
        "onCreation": true,
        "onApproval": false,
        "onCompletion": true
      }
    },
    {
      "id": "nominee-change",
      "name": "Nominee Change",
      "displayName": "Change Nominee",
      "icon": "👤",
      "description": "Update the registered nominee for the policy",
      "category": "Administrative",
      "priority": "High",
      "requiredFields": [
        "nomineeName",
        "nomineeRelationship",
        "nomineeIdProof"
      ],
      "optionalFields": [
        "nomineeAge",
        "nomineePhone",
        "nomineeEmail",
        "notes"
      ],
      "eligibilityRules": [
        {
          "field": "policyStatus",
          "condition": "equals",
          "values": ["Active"],
          "message": "Policy must be Active"
        },
        {
          "field": "outstandingClaims",
          "condition": "equals",
          "values": [false],
          "message": "No outstanding claims on the policy"
        }
      ],
      "requiredApproval": true,
      "sla": {
        "days": 3,
        "businessHoursOnly": true
      },
      "automationRules": [
        {
          "action": "updateField",
          "field": "registeredNominee",
          "source": "nomineeName"
        },
        {
          "action": "flagForCompliance",
          "message": "Nominee change requires compliance review"
        }
      ],
      "notification": {
        "onCreation": true,
        "onApproval": true,
        "onCompletion": true
      }
    },
    {
      "id": "premium-mode-change",
      "name": "Premium Mode Change",
      "displayName": "Change Payment Frequency",
      "icon": "💰",
      "description": "Switch between Monthly, Quarterly, or Annual premium payments",
      "category": "Billing",
      "priority": "Medium",
      "requiredFields": [
        "newPremiumMode",
        "effectiveDate"
      ],
      "optionalFields": [
        "reason",
        "notes"
      ],
      "eligibilityRules": [
        {
          "field": "policyStatus",
          "condition": "equals",
          "values": ["Active"],
          "message": "Policy must be Active"
        },
        {
          "field": "premiumMode",
          "condition": "equals",
          "values": ["Annual"],
          "message": "Policy must be in Annual mode to change to Monthly/Quarterly"
        },
        {
          "field": "paymentDefaults12Months",
          "condition": "lessThan",
          "values": [1],
          "message": "No payment failures in the last 12 months"
        }
      ],
      "requiredApproval": true,
      "sla": {
        "days": 5,
        "businessHoursOnly": true
      },
      "automationRules": [
        {
          "action": "callFlow",
          "flowName": "UpdateBillingSystem",
          "reason": "Sync with billing backend"
        },
        {
          "action": "updateField",
          "field": "premiumMode",
          "source": "newPremiumMode"
        }
      ],
      "notification": {
        "onCreation": true,
        "onApproval": true,
        "onCompletion": true
      }
    },
    {
      "id": "info-update",
      "name": "Information Update",
      "displayName": "Update Policy Information",
      "icon": "📋",
      "description": "Update other policy information (email, phone, coverage details, etc.)",
      "category": "Administrative",
      "priority": "Low",
      "requiredFields": [
        "fieldToUpdate",
        "newValue",
        "verificationId"
      ],
      "optionalFields": [
        "oldValue",
        "reason",
        "notes"
      ],
      "eligibilityRules": [
        {
          "field": "policyStatus",
          "condition": "notIn",
          "values": ["Lapsed"],
          "message": "Policy must not be Lapsed"
        }
      ],
      "requiredApproval": false,
      "sla": {
        "days": 1,
        "businessHoursOnly": false
      },
      "automationRules": [
        {
          "action": "updateField",
          "field": "dynamicField",
          "source": "newValue"
        }
      ],
      "notification": {
        "onCreation": true,
        "onApproval": false,
        "onCompletion": true
      }
    }
  ],
